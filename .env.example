# Name of the database in the PostgreSQL container
PG_DATABASE="cinnamon_db"

# Password of the database user
PG_PASSWORD=

# Name of the database user
PG_USERNAME="cinnamon_user"

# File upload limits
MAX_FILE_SIZE_BYTES=52428800

# Selectable LLM profiles shown in synthesis configuration
CINNAMON_LLM_PROFILE_IDS=qwen14b,ollama-qwen3-8b

CINNAMON_LLM_PROFILE_QWEN14B_NAME="Qwen 14B (OpenAI-compatible)"
CINNAMON_LLM_PROFILE_QWEN14B_PROVIDER="openai_compatible"
CINNAMON_LLM_PROFILE_QWEN14B_MODEL_NAME="Qwen/Qwen2.5-14B-Instruct"
CINNAMON_LLM_PROFILE_QWEN14B_BASE_URL="http://gpu.example.org:7086"
CINNAMON_LLM_PROFILE_QWEN14B_ENDPOINT_PATH="/v1/chat/completions"
CINNAMON_LLM_PROFILE_QWEN14B_HEALTHCHECK_PATH="/v1/models"
CINNAMON_LLM_PROFILE_QWEN14B_API_KEY=""
CINNAMON_LLM_PROFILE_QWEN14B_TIMEOUT_SECONDS=120
CINNAMON_LLM_PROFILE_QWEN14B_MAX_RETRIES=3
CINNAMON_LLM_PROFILE_QWEN14B_VERIFY_SSL=true
CINNAMON_LLM_PROFILE_QWEN14B_MAX_TOKENS=8192

CINNAMON_LLM_PROFILE_OLLAMA_QWEN3_8B_NAME="Ollama Qwen3 8B (local)"
CINNAMON_LLM_PROFILE_OLLAMA_QWEN3_8B_PROVIDER="ollama"
CINNAMON_LLM_PROFILE_OLLAMA_QWEN3_8B_MODEL_NAME="qwen3:8b"
CINNAMON_LLM_PROFILE_OLLAMA_QWEN3_8B_BASE_URL="http://host.docker.internal:11434"
CINNAMON_LLM_PROFILE_OLLAMA_QWEN3_8B_ENDPOINT_PATH="/api/generate"
CINNAMON_LLM_PROFILE_OLLAMA_QWEN3_8B_HEALTHCHECK_PATH="/api/tags"
CINNAMON_LLM_PROFILE_OLLAMA_QWEN3_8B_API_KEY=""
CINNAMON_LLM_PROFILE_OLLAMA_QWEN3_8B_TIMEOUT_SECONDS=300
CINNAMON_LLM_PROFILE_OLLAMA_QWEN3_8B_MAX_RETRIES=3
CINNAMON_LLM_PROFILE_OLLAMA_QWEN3_8B_VERIFY_SSL=true
CINNAMON_LLM_PROFILE_OLLAMA_QWEN3_8B_MAX_TOKENS=8192

# Selectable embedding profiles shown in nearest-neighbor text synthesis configuration
# macOS setup example:
#   brew install --cask ollama
#   open -a Ollama
#   ollama pull all-minilm:22m
#   ollama pull all-minilm:33m
#   ollama pull embeddinggemma:300m
# When Cinnamon runs in Docker, keep the Ollama base URL on host.docker.internal.
CINNAMON_EMBEDDING_PROFILE_IDS=ollama-all-minilm-22m,ollama-all-minilm-33m,ollama-embeddinggemma-300m

CINNAMON_EMBEDDING_PROFILE_OLLAMA_ALL_MINILM_22M_NAME="Ollama all-minilm 22M (local)"
CINNAMON_EMBEDDING_PROFILE_OLLAMA_ALL_MINILM_22M_PROVIDER="ollama"
CINNAMON_EMBEDDING_PROFILE_OLLAMA_ALL_MINILM_22M_MODEL_NAME="all-minilm:22m"
CINNAMON_EMBEDDING_PROFILE_OLLAMA_ALL_MINILM_22M_BASE_URL="http://host.docker.internal:11434"
CINNAMON_EMBEDDING_PROFILE_OLLAMA_ALL_MINILM_22M_ENDPOINT_PATH="/api/embed"
CINNAMON_EMBEDDING_PROFILE_OLLAMA_ALL_MINILM_22M_HEALTHCHECK_PATH="/api/tags"
CINNAMON_EMBEDDING_PROFILE_OLLAMA_ALL_MINILM_22M_TIMEOUT_SECONDS=120
CINNAMON_EMBEDDING_PROFILE_OLLAMA_ALL_MINILM_22M_MAX_RETRIES=3
CINNAMON_EMBEDDING_PROFILE_OLLAMA_ALL_MINILM_22M_VERIFY_SSL=true

CINNAMON_EMBEDDING_PROFILE_OLLAMA_ALL_MINILM_33M_NAME="Ollama all-minilm 33M (local)"
CINNAMON_EMBEDDING_PROFILE_OLLAMA_ALL_MINILM_33M_PROVIDER="ollama"
CINNAMON_EMBEDDING_PROFILE_OLLAMA_ALL_MINILM_33M_MODEL_NAME="all-minilm:33m"
CINNAMON_EMBEDDING_PROFILE_OLLAMA_ALL_MINILM_33M_BASE_URL="http://host.docker.internal:11434"
CINNAMON_EMBEDDING_PROFILE_OLLAMA_ALL_MINILM_33M_ENDPOINT_PATH="/api/embed"
CINNAMON_EMBEDDING_PROFILE_OLLAMA_ALL_MINILM_33M_HEALTHCHECK_PATH="/api/tags"
CINNAMON_EMBEDDING_PROFILE_OLLAMA_ALL_MINILM_33M_TIMEOUT_SECONDS=120
CINNAMON_EMBEDDING_PROFILE_OLLAMA_ALL_MINILM_33M_MAX_RETRIES=3
CINNAMON_EMBEDDING_PROFILE_OLLAMA_ALL_MINILM_33M_VERIFY_SSL=true

CINNAMON_EMBEDDING_PROFILE_OLLAMA_EMBEDDINGGEMMA_300M_NAME="Ollama EmbeddingGemma 300M (local)"
CINNAMON_EMBEDDING_PROFILE_OLLAMA_EMBEDDINGGEMMA_300M_PROVIDER="ollama"
CINNAMON_EMBEDDING_PROFILE_OLLAMA_EMBEDDINGGEMMA_300M_MODEL_NAME="embeddinggemma:300m"
CINNAMON_EMBEDDING_PROFILE_OLLAMA_EMBEDDINGGEMMA_300M_BASE_URL="http://host.docker.internal:11434"
CINNAMON_EMBEDDING_PROFILE_OLLAMA_EMBEDDINGGEMMA_300M_ENDPOINT_PATH="/api/embed"
CINNAMON_EMBEDDING_PROFILE_OLLAMA_EMBEDDINGGEMMA_300M_HEALTHCHECK_PATH="/api/tags"
CINNAMON_EMBEDDING_PROFILE_OLLAMA_EMBEDDINGGEMMA_300M_TIMEOUT_SECONDS=120
CINNAMON_EMBEDDING_PROFILE_OLLAMA_EMBEDDINGGEMMA_300M_MAX_RETRIES=3
CINNAMON_EMBEDDING_PROFILE_OLLAMA_EMBEDDINGGEMMA_300M_VERIFY_SSL=true


# Text-anonymization env variables
TEXT_ANONYMIZATION_MODEL_HOST_PATH=./cinnamon-text-anonymization/models
TEXT_ANONYMIZATION_MODEL_MOUNT_MODE=ro # set to rw when Hugging Face fallback downloads are enabled
TEXT_ANONYMIZATION_STATUS_HOST_PATH=./cinnamon-text-anonymization/outputs/status
TEXT_ANONYMIZATION_XLM_LOCAL_PATH=models/xlm-grascco #local xlm model path
TEXT_ANONYMIZATION_GELECTRA_LOCAL_PATH=models/gelectra-grascco # local gelectra model path
HF_TOKEN_FILE=./secrets/hf_token # HF token for fetching the models below
TEXT_ANONYMIZATION_XLM_HF_REPOSITORY=ki-aim/xlm-grascco
TEXT_ANONYMIZATION_GELECTRA_HF_REPOSITORY=ki-aim/gelectra-grascco
TEXT_ANONYMIZATION_MODEL_CACHE=models #
