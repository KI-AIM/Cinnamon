# Name of the database in the PostgreSQL container
PG_DATABASE="cinnamon_db"

# Password of the database user
PG_PASSWORD=

# Name of the database user
PG_USERNAME="cinnamon_user"

# File upload limits
MAX_FILE_SIZE_BYTES=52428800

# Shared LLM configuration for cinnamon-synthetization
# Use the URL of your external GPU / inference server here.
# If your server does not require authentication, leave CINNAMON_LLM_API_KEY empty.
# When CINNAMON_LLM_API_KEY is empty, no Authorization header is sent.
CINNAMON_LLM_PROVIDER="openai_compatible"
CINNAMON_LLM_MODEL_NAME=""
CINNAMON_LLM_BASE_URL=""
CINNAMON_LLM_ENDPOINT_PATH="/v1/chat/completions"
CINNAMON_LLM_HEALTHCHECK_PATH="/v1/models"
CINNAMON_LLM_API_KEY=""
CINNAMON_LLM_TIMEOUT_SECONDS=120
CINNAMON_LLM_MAX_RETRIES=3
CINNAMON_LLM_VERIFY_SSL=true
CINNAMON_LLM_TEMPERATURE=0.0
CINNAMON_LLM_TOP_P=1.0
CINNAMON_LLM_MAX_TOKENS=4096

# Example 1: External GPU server with API key
# CINNAMON_LLM_PROVIDER="openai_compatible"
# CINNAMON_LLM_MODEL_NAME="Qwen/Qwen3-32B"
# CINNAMON_LLM_BASE_URL="https://gpu-a.example.org:8443"
# CINNAMON_LLM_ENDPOINT_PATH="/v1/chat/completions"
# CINNAMON_LLM_HEALTHCHECK_PATH="/v1/models"
# CINNAMON_LLM_API_KEY="replace-me"
# CINNAMON_LLM_TIMEOUT_SECONDS=180
# CINNAMON_LLM_MAX_RETRIES=5
# CINNAMON_LLM_VERIFY_SSL=true
# CINNAMON_LLM_TEMPERATURE=0.0
# CINNAMON_LLM_TOP_P=1.0
# CINNAMON_LLM_MAX_TOKENS=4096

# Example 2: External GPU server without API key
# CINNAMON_LLM_PROVIDER="openai_compatible"
# CINNAMON_LLM_MODEL_NAME="Meta-Llama-3.1-70B-Instruct"
# CINNAMON_LLM_BASE_URL="http://10.10.20.15:8000"
# CINNAMON_LLM_ENDPOINT_PATH="/v1/chat/completions"
# CINNAMON_LLM_HEALTHCHECK_PATH="/v1/models"
# CINNAMON_LLM_API_KEY=""
# CINNAMON_LLM_TIMEOUT_SECONDS=120
# CINNAMON_LLM_MAX_RETRIES=3
# CINNAMON_LLM_VERIFY_SSL=false
# CINNAMON_LLM_TEMPERATURE=0.0
# CINNAMON_LLM_TOP_P=1.0
# CINNAMON_LLM_MAX_TOKENS=4096
