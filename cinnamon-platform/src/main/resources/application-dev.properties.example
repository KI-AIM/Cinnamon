cinnamon.external-server.anonymization-server.callback-host=host.docker.internal
cinnamon.external-server.synthetization-server.callback-host=host.docker.internal
cinnamon.external-server.technical-evaluation-server.callback-host=host.docker.internal
cinnamon.external-server.risk-assessment-server.callback-host=host.docker.internal

cinnamon.password-requirements.min-length=1
cinnamon.password-requirements.constraints=lowercase

logging.level.de.kiaim.cinnamon.platform=debug

management.endpoint.health.show-components=always
management.endpoint.health.show-details=always

spring.datasource.password=${PG_PASSWORD}
