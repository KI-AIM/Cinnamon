# Name of the database in the PostgreSQL container
PG_DATABASE="cinnamon_db"

# Password of the database user
PG_PASSWORD=

# Name of the database user
PG_USERNAME="cinnamon_user"

# File upload limits
MAX_FILE_SIZE_BYTES=52428800

# Text-anonymization env variables
TEXT_ANONYMIZATION_MODEL_HOST_PATH=./cinnamon-text-anonymization/models
TEXT_ANONYMIZATION_MODEL_MOUNT_MODE=ro # set to rw when Hugging Face fallback downloads are enabled
TEXT_ANONYMIZATION_XLM_LOCAL_PATH=models/xlm-grascco #local xlm model path
TEXT_ANONYMIZATION_GELECTRA_LOCAL_PATH=models/gelectra-grascco # local gelectra model path
HF_TOKEN_FILE=./secrets/hf_token # HF token for fetching the models below
TEXT_ANONYMIZATION_XLM_HF_REPOSITORY=ki-aim/xlm-grascco
TEXT_ANONYMIZATION_GELECTRA_HF_REPOSITORY=ki-aim/gelectra-grascco
TEXT_ANONYMIZATION_MODEL_CACHE=models #

# Fallback single-LLM config (used if no llm_profile is selected)
CINNAMON_LLM_PROVIDER="openai_compatible"
CINNAMON_LLM_MODEL_NAME=""
CINNAMON_LLM_BASE_URL=""
CINNAMON_LLM_ENDPOINT_PATH="/v1/chat/completions"
CINNAMON_LLM_HEALTHCHECK_PATH="/v1/models"
CINNAMON_LLM_API_KEY=""
CINNAMON_LLM_TIMEOUT_SECONDS=120
CINNAMON_LLM_MAX_RETRIES=3
CINNAMON_LLM_VERIFY_SSL=true
CINNAMON_LLM_TEMPERATURE=0.0
CINNAMON_LLM_TOP_P=1.0
CINNAMON_LLM_MAX_TOKENS=1024

# Selectable LLM profiles shown in synthesis configuration
CINNAMON_LLM_PROFILE_IDS=qwen14b,mistral7b,llama8b

CINNAMON_LLM_PROFILE_QWEN14B_NAME="Qwen 14B (GPU 7086)"
CINNAMON_LLM_PROFILE_QWEN14B_PROVIDER="openai_compatible"
CINNAMON_LLM_PROFILE_QWEN14B_MODEL_NAME="Qwen/Qwen2.5-14B-Instruct"
CINNAMON_LLM_PROFILE_QWEN14B_BASE_URL="http://..."
CINNAMON_LLM_PROFILE_QWEN14B_ENDPOINT_PATH="/v1/chat/completions"
CINNAMON_LLM_PROFILE_QWEN14B_HEALTHCHECK_PATH="/v1/models"
CINNAMON_LLM_PROFILE_QWEN14B_API_KEY=""
CINNAMON_LLM_PROFILE_QWEN14B_TIMEOUT_SECONDS=120
CINNAMON_LLM_PROFILE_QWEN14B_MAX_RETRIES=3
CINNAMON_LLM_PROFILE_QWEN14B_VERIFY_SSL=true
CINNAMON_LLM_PROFILE_QWEN14B_MAX_TOKENS=1024

CINNAMON_LLM_PROFILE_MISTRAL7B_NAME="Mistral 7B (GPU 7087)"
CINNAMON_LLM_PROFILE_MISTRAL7B_PROVIDER="openai_compatible"
CINNAMON_LLM_PROFILE_MISTRAL7B_MODEL_NAME="mistralai/Mistral-7B-Instruct-v0.3"
CINNAMON_LLM_PROFILE_MISTRAL7B_BASE_URL="http://..."
CINNAMON_LLM_PROFILE_MISTRAL7B_ENDPOINT_PATH="/v1/chat/completions"
CINNAMON_LLM_PROFILE_MISTRAL7B_HEALTHCHECK_PATH="/v1/models"
CINNAMON_LLM_PROFILE_MISTRAL7B_API_KEY=""
CINNAMON_LLM_PROFILE_MISTRAL7B_TIMEOUT_SECONDS=120
CINNAMON_LLM_PROFILE_MISTRAL7B_MAX_RETRIES=3
CINNAMON_LLM_PROFILE_MISTRAL7B_VERIFY_SSL=true
CINNAMON_LLM_PROFILE_MISTRAL7B_MAX_TOKENS=1024

CINNAMON_LLM_PROFILE_LLAMA8B_NAME="Llama 3.1 8B (GPU 7088)"
CINNAMON_LLM_PROFILE_LLAMA8B_PROVIDER="openai_compatible"
CINNAMON_LLM_PROFILE_LLAMA8B_MODEL_NAME="meta-llama/Meta-Llama-3.1-8B-Instruct"
CINNAMON_LLM_PROFILE_LLAMA8B_BASE_URL="..."
CINNAMON_LLM_PROFILE_LLAMA8B_ENDPOINT_PATH="/v1/chat/completions"
CINNAMON_LLM_PROFILE_LLAMA8B_HEALTHCHECK_PATH="/v1/models"
CINNAMON_LLM_PROFILE_LLAMA8B_API_KEY=""
CINNAMON_LLM_PROFILE_LLAMA8B_TIMEOUT_SECONDS=120
CINNAMON_LLM_PROFILE_LLAMA8B_MAX_RETRIES=3
CINNAMON_LLM_PROFILE_LLAMA8B_VERIFY_SSL=true
CINNAMON_LLM_PROFILE_LLAMA8B_MAX_TOKENS=1024
